{
  "expo": {
    "name": "Winify",
    "slug": "winify",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.winify.app" },
    "android": { "package": "com.winify.app" },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router"],
    "scheme": "winify",
    "experiments": {
      "newArchEnabled": false
    }
  }
}

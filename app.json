{
  "expo": {
    "name": "Winify",
    "slug": "winify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#6D28D9"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.winify.app" },
    "android": { "package": "com.winify.app", "adaptiveIcon": { "backgroundColor": "#6D28D9" } },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-font"],
    "scheme": "winify",
    "sdkVersion": "52.0.0",
    "experiments": { "typedRoutes": false }
  }
}
